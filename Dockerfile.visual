FROM mcr.microsoft.com/playwright@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea
WORKDIR /runner
RUN npm install --ignore-scripts --save-exact @playwright/test@1.64.1
COPY playwright.config.ts ./playwright.config.ts
COPY scripts/ui/server.mjs scripts/ui/runtime.mjs scripts/ui/rendered.spec.mjs scripts/ui/visual-contracts.mjs ./scripts/ui/
COPY scripts/ui/fidelity-runner.mjs scripts/ui/fidelity-contracts.mjs ./scripts/ui/
ENV CI=1
CMD ["node", "node_modules/@playwright/test/cli.js", "test", "--config", "playwright.config.ts"]
