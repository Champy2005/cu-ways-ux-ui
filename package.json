{
  "name": "cu-ways-ux-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "ui": "tsx scripts/ui/index.ts",
    "dev": "storybook dev --host 127.0.0.1 --port 4191 --exact-port --no-open --disable-telemetry",
    "build": "storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project stories"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-mcp": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "9.39.5",
    "fflate": "0.8.2",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "react-docgen-typescript": "2.4.0",
    "storybook": "10.6.5",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
